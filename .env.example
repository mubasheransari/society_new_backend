PORT=4000

# --- Local Postgres (used if DATABASE_URL / POSTGRES_URL is not set) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=society_management
DB_USER=stranger
DB_PASSWORD=112233
DB_SSL=false

# --- Hosted Postgres (Vercel Postgres, Neon, Supabase, Render, etc.) ---
# Set this in Vercel's Environment Variables instead of committing real
# credentials here. Vercel Postgres provides POSTGRES_URL automatically
# when you link the database to this project.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# POSTGRES_URL=postgres://user:password@host:5432/dbname

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
DEFAULT_RESIDENT_PASSWORD=123456